# Copy to .env and adjust. All variables are required (WP_PLUGINS may be empty).

# Workspace: directory containing the project checkouts, relative to this directory.
# Mounted as /workspace (read-only in the wordpress container). Projects that
# reference each other via relative paths (e.g. Composer path repositories)
# keep working because the structure below /workspace matches the host.
WORKSPACE_DIR=..

# Projects in the workspace (comma-separated directory names), linked into
# wp-content/themes and wp-content/plugins. Listed plugins are activated.
WP_THEMES=my-theme
WP_PLUGINS=
WP_ACTIVE_THEME=my-theme

# Host port of Traefik, the single entry point for all services.
# Must be 80: WP_URL has no port, and WordPress calls itself (WP-Cron, Site Health)
# at WP_URL from inside its container, where Apache listens on port 80.
# scripts/setup verifies that these loopback requests work.
HTTP_PORT=80

# Host names routed by Traefik. *.localhost resolves to the loopback address in
# browsers and curl. The WordPress host needs a dot (PHPMailer rejects the sender
# wordpress@localhost).
WP_HOST=wp-dev.localhost
MAILPIT_HOST=mailpit.localhost
TRAEFIK_HOST=traefik.localhost

# Public URL of the development site (WP_HOME / WP_SITEURL), without port (port 80).
# Changing it needs no search-replace in the database.
WP_URL=http://${WP_HOST}

# Host user; containers write files as this user (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress

# WordPress installation (scripts/setup)
WP_TITLE="WordPress Development"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

# Xdebug: off | debug | develop | profile | trace (comma-separated)
XDEBUG_MODE=off
