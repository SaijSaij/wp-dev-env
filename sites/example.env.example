# Copy to sites/<site>.env (lowercase letters, digits and hyphens) and adjust;
# scripts/setup <site> then runs the site at http://<site>.localhost with its own
# database and uploads in data/sites/<site>. Every variable is required but may be
# empty where noted.

# Projects in the workspace (comma-separated paths relative to the workspace),
# linked into wp-content/themes and wp-content/plugins under their last path
# segment, e.g. my-theme or clients/my-plugin. Listed plugins are activated.
# Both may be empty.
WP_THEMES=my-theme
WP_PLUGINS=

# Theme to activate (its directory name): a linked project or a theme that ships
# with WordPress, such as twentytwentyfive.
WP_ACTIVE_THEME=my-theme

# Composer packages replaced by a symlink to their checkout in the workspace
# (comma-separated vendor/package=path, may be empty). scripts/setup sets the
# relative links in every listed project after composer install; lock files and
# composer.json stay unchanged.
WP_PACKAGE_LINKS=

# Site title used when the site is installed.
WP_TITLE="WordPress Development"

# Persistent object cache: empty for none, or valkey to start the valkey service
# (profile objectcache) and install the object cache drop-in of the Redis Object
# Cache plugin. scripts/setup applies a change (it recreates the containers).
WP_OBJECT_CACHE=
