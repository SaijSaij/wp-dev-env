#!/usr/bin/env bash
# Release test: installs release ZIPs – one theme, optionally a child theme of
# it, and any number of plugins – into a fresh, plain WordPress (profile release,
# no workspace mounts, nothing persisted), activates them (the child theme, if
# given, instead of the theme) and makes their directories read-only. The site
# runs at WP_RELEASE_URL.
#
# Usage: scripts/release-test --theme <theme.zip> [--child-theme <child.zip>] [--plugin <plugin.zip>]...
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
    echo "Usage: scripts/release-test --theme <theme.zip> [--child-theme <child.zip>] [--plugin <plugin.zip>]..." >&2
    exit 2
}

theme_zip=""
child_zip=""
plugin_zips=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --theme)
            [[ $# -ge 2 && -z "${theme_zip}" ]] || usage
            theme_zip="$2"
            shift 2
            ;;
        --child-theme)
            [[ $# -ge 2 && -z "${child_zip}" ]] || usage
            child_zip="$2"
            shift 2
            ;;
        --plugin)
            [[ $# -ge 2 ]] || usage
            plugin_zips+=("$2")
            shift 2
            ;;
        *)
            echo "Unknown argument '$1'." >&2
            usage
            ;;
    esac
done
[[ -n "${theme_zip}" ]] || usage
zips=("${theme_zip}")
[[ -z "${child_zip}" ]] || zips+=("${child_zip}")
zips+=("${plugin_zips[@]}")
for zip in "${zips[@]}"; do
    if [[ ! -f "${zip}" ]]; then
        echo "ERROR: release ZIP '${zip}' not found." >&2
        exit 1
    fi
done

if [[ ! -f .env ]]; then
    echo "ERROR: $(pwd)/.env not found. Copy .env.example to .env and adjust it." >&2
    exit 1
fi
set -a
# shellcheck source=/dev/null
source .env
set +a

# The container sees the ZIPs below /release (data/release, read-only).
mkdir -p data/release
for zip in "${zips[@]}"; do
    cp "${zip}" "data/release/$(basename "${zip}")"
done

# A fresh database and WordPress on every run (both on tmpfs).
docker compose --profile release rm --stop --force wordpress-release db-release
docker compose --profile release up -d --wait traefik db-release wordpress-release

if ! docker compose exec -T wordpress-release curl -fsS -o /dev/null "${WP_RELEASE_URL}/readme.html"; then
    echo "ERROR: ${WP_RELEASE_URL} is not reachable from inside the wordpress-release container. WP_RELEASE_URL must be http://${WP_RELEASE_HOST}." >&2
    exit 1
fi

wp() {
    docker compose exec -T -u www-data wordpress-release wp "$@"
}

wp core install \
    --url="${WP_RELEASE_URL}" \
    --title="Release test" \
    --admin_user="${WP_ADMIN_USER}" \
    --admin_password="${WP_ADMIN_PASSWORD}" \
    --admin_email="${WP_ADMIN_EMAIL}" \
    --skip-email
wp rewrite structure '/%postname%/'

# Read-only like a deployment without write access: nothing may write into the installed projects.
read_only() {
    local directory="$1"
    docker compose exec -T wordpress-release chmod -R a-w "${directory}"
    if docker compose exec -T -u www-data wordpress-release touch "${directory}/.write-test" 2>/dev/null; then
        echo "ERROR: ${directory} is still writable for www-data." >&2
        exit 1
    fi
}

# The directory name of the theme a ZIP installed, from the theme list before and after.
install_theme() {
    local before installed
    before="$(wp theme list --field=name | sort)"
    wp theme install "/release/$(basename "$1")" >&2
    installed="$(comm -13 <(echo "${before}") <(wp theme list --field=name | sort))"
    if [[ -z "${installed}" || "${installed}" == *$'\n'* ]]; then
        echo "ERROR: cannot tell which theme $1 installed." >&2
        exit 1
    fi
    echo "${installed}"
}

# The parent theme first: WordPress would try to download a missing parent theme from wordpress.org.
theme="$(install_theme "${theme_zip}")"
child=""
if [[ -n "${child_zip}" ]]; then
    child="$(install_theme "${child_zip}")"
    parent="$(wp theme get "${child}" --field=template)"
    if [[ "${parent}" != "${theme}" ]]; then
        echo "ERROR: the child theme ${child} from $(basename "${child_zip}") names the parent theme '${parent}', but $(basename "${theme_zip}") installed ${theme}." >&2
        exit 1
    fi
    wp theme activate "${child}"
    read_only "/var/www/html/wp-content/themes/${child}"
else
    wp theme activate "${theme}"
fi
read_only "/var/www/html/wp-content/themes/${theme}"

plugins=()
for zip in "${plugin_zips[@]}"; do
    before="$(wp plugin list --field=name | sort)"
    wp plugin install "/release/$(basename "${zip}")" --activate
    plugin="$(comm -13 <(echo "${before}") <(wp plugin list --field=name | sort))"
    if [[ -z "${plugin}" || "${plugin}" == *$'\n'* ]]; then
        echo "ERROR: cannot tell which plugin ${zip} installed." >&2
        exit 1
    fi
    read_only "/var/www/html/wp-content/plugins/${plugin}"
    plugins+=("${plugin}")
done

status="$(docker compose exec -T wordpress-release curl -sS -o /dev/null -w '%{http_code}' "${WP_RELEASE_URL}/")"
if [[ "${status}" != "200" ]]; then
    echo "ERROR: the front page of the release site answers HTTP ${status}." >&2
    exit 1
fi

echo
echo "WordPress $(wp core version) running at ${WP_RELEASE_URL}"
if [[ -n "${child}" ]]; then
    echo "Active theme:   ${child} $(wp theme get "${child}" --field=version) from $(basename "${child_zip}") (read-only)"
    echo "Parent theme:   ${theme} $(wp theme get "${theme}" --field=version) from $(basename "${theme_zip}") (read-only)"
else
    echo "Active theme:   ${theme} $(wp theme get "${theme}" --field=version) from $(basename "${theme_zip}") (read-only)"
fi
for plugin in "${plugins[@]}"; do
    echo "Active plugin:  ${plugin} $(wp plugin get "${plugin}" --field=version) (read-only)"
done
echo "Stop with:      docker compose --profile release rm --stop --force wordpress-release db-release"
