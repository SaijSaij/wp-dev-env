#!/usr/bin/env bash
# Restores a defined state of one site: stops it if it is active, deletes its
# database and uploads (data/sites/<site>), then runs the setup again.
# Other sites keep their data.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# shellcheck source=lib/site.sh
source lib/site.sh

if (( $# != 1 )); then
    echo "Usage: scripts/reset <site>" >&2
    exit 1
fi
site="$1"
check_site_name "${site}"
if [[ ! -f "sites/${site}.env" ]]; then
    echo "ERROR: $(pwd)/sites/${site}.env not found." >&2
    exit 1
fi

if [[ -f .env && "$(sed -n 's/^WP_SITE=//p' .env)" == "${site}" ]]; then
    stop_containers
fi
rm -rf -- "data/sites/${site}"

exec scripts/setup "${site}"
