# Copy to config.env and adjust. Settings shared by all sites; every variable is
# required. The projects of a site are configured in sites/<site>.env.

# Workspace: directory containing the project checkouts, relative to this directory.
# Mounted as /workspace (read-only in the wordpress container). Projects that
# reference each other via relative paths (e.g. Composer path repositories)
# keep working because the structure below /workspace matches the host.
WORKSPACE_DIR=..

# Host port of Traefik, the single entry point for all services.
# Must be 80: the site URL has no port, and WordPress calls itself (WP-Cron, Site
# Health) at its URL from inside its container, where Apache listens on port 80.
# scripts/setup verifies that these loopback requests work.
HTTP_PORT=80

# Host names of Mailpit and the Traefik dashboard. *.localhost resolves to the
# loopback address in browsers and curl. The site itself runs at <site>.localhost.
MAILPIT_HOST=mailpit.localhost
TRAEFIK_HOST=traefik.localhost

# Host user; containers write files as this user (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Database (every site has its own database directory)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress

# Administrator created when a site is installed (scripts/setup)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

# Xdebug: off | debug | develop | profile | trace (comma-separated)
XDEBUG_MODE=off
